ion dans les autres langues.","api":["\\se.dʁik\\","[se.dʁik]"],"origines":["gaulois","proto-brittonique"],"url":"https://fr.wiktionary.org/wiki/C%C3%A9dric"}]},"céleste":{"variantes":[{"libelle":"Célestin","type":"apparente","id":"célestin"},{"libelle":"Célestine","type":"apparente","id":"célestine"},{"libelle":"Marie-Céleste","type":"compose"}],"entrees":[{"mot":"Céleste","section":"Prénom","etymologie":"De l'adjectif céleste.","api":["\\se.lɛst\\"],"origines":[],"url":"https://fr.wiktionary.org/wiki/C%C3%A9leste"}]},"célestin":{"variantes":[{"libelle":"Célestine","type":"equivalent_autre_genre","id":"célestine"},{"libelle":"Coelestin","type":"traduction","langue":"Allemand"},{"libelle":"Celestine","type":"traduction","id":"celestine","langue":"Anglais"},{"libelle":"Celestino","type":"traduction","id":"celestino","langue":"Espagnol"},{"libelle":"Celestino","type":"traduction","id":"celestino","langue":"Galicien"},{"libelle":"Κελεστίνος","type":"traduction","langue":"Grec"},{"libelle":"Celestyn","type":"traduction","langue":"Polonais"},{"libelle":"Целестин","type":"traduction","langue":"Russe"},{"libelle":"Celestýn","type":"traduction","langue":"Tchèque"}],"entrees":[{"mot":"Célestin","section":"Prénom","etymologie":"Du latin Caelestinus.","api":["\\se.lɛs.tɛ̃\\"],"origines":["latin"],"url":"https://fr.wiktionary.org/wiki/C%C3%A9lestin"}]},"célestine":{"variantes":[{"libelle":"Célestin","type":"equivalent_autre_genre","id":"célestin"},{"libelle":"Celestina","type":"orthographique","id":"celestina"}],"entrees":[{"mot":"Célestine","section":"Prénom","etymologie":"→ voir Célestin","api":["\\se.lɛs.tin\\"],"origines":[],"url":"https://fr.wiktionary.org/wiki/C%C3%A9lestine"}]},"célia":{"variantes":[{"libelle":"Celia","type":"traduction","id":"celia","langue":"Anglais"},{"libelle":"Cèlia","type":"traduction","id":"cèlia","langue":"Catalan"},{"libelle":"Celia","type":"traduction","id":"celia","langue":"Espagnol"},{"libelle":"Celia","type":"traduction","id":"celia","langue