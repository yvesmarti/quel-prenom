son et Logan. Quand je commençai, pour de bon, à parler de mon pays en lui donnant ce nom charmant de Laurentie, je ne me doutais guère qu'on s'en emparerait un jour pour lui donner une signification politique aussi précise. — (Marie-Victorin, « Pour un institut de géologie », Le Devoir, 27 janvier 1937, page 10)","api":["\\lo.ʁɑ̃.si\\"],"origines":[],"url":"https://fr.wiktionary.org/wiki/Laurentie"}]},"laurette":{"variantes":[{"libelle":"Marie-Laurette","type":"compose","id":"marie-laurette"},{"libelle":"Loretta","type":"orthographique","id":"loretta"},{"libelle":"Lorette","type":"orthographique","id":"lorette"}],"entrees":[{"mot":"Laurette","section":"Prénom","etymologie":"Nomdérivé de Laure, avec le suffixe -ette ; → voir Laure.","api":["\\lɔ.ʁɛt\\"],"origines":[],"url":"https://fr.wiktionary.org/wiki/Laurette"}]},"lauriane":{"variantes":[{"libelle":"Laurianne","type":"orthographique","id":"laurianne"},{"libelle":"Loriane","type":"orthographique","id":"loriane"}],"entrees":[{"mot":"Lauriane","section":"Prénom","etymologie":"→ voir Laurianne.","api":["\\lɔ.ʁjan\\"],"origines":[],"url":"https://fr.wiktionary.org/wiki/Lauriane"}]},"laurianne":{"variantes":[{"libelle":"Lauriane","type":"orthographique","id":"lauriane"},{"libelle":"Loriane","type":"orthographique","id":"loriane"}],"entrees":[{"mot":"Laurianne","section":"Prénom","etymologie":null,"api":["\\lɔ.ʁjan\\"],"origines":[],"url":"https://fr.wiktionary.org/wiki/Laurianne"}]},"laurène":{"variantes":[{"libelle":"Marie-Laurène","type":"compose"},{"libelle":"Lauren","type":"orthographique","id":"lauren"},{"libelle":"Laurenn","type":"orthographique","id":"laurenn"},{"libelle":"Laurenne","type":"orthographique","id":"laurenne"},{"libelle":"Loren","type":"orthographique","id":"loren"},{"libelle":"Lorenn","type":"orthographique","id":"lorenn"},{"libelle":"Lorenne","type":"orthographique","id":"lorenne"},{"libelle":"Lorrène","type":"orthographique"},{"libelle":"Lorène","type":"orthographique","id":"lorène"}],"entrees":