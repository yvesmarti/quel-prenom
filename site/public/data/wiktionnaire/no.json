on"}],"entrees":[{"mot":"Noël","section":"Prénom","etymologie":"Ce prénom latin est donné d’après la fête chrétienne, comme l’est aussi Toussaint. Cette forme vient de la zone d’oïl, on trouve surtout la forme Nouvel dans la zone occitane, qui n’est qu’une forme occitane du latin natale d’après le saint Nouvel. Ces formes viennent du latin Natalis, originellement un prénom d’homme chrétien issu du nom propre. Le prénom masculin ainsi que la forme féminine Noëlle sont en usage depuis l’époque médiévale. Ils n’ont jamais été très fréquents mais restent donnés jusque dans les années 1960. Ils deviennent ensuite de plus en plus rares. Toutes les variantes féminines de Noëlle ne sont, elles, que restées rarissimes ou marginales.","api":["\\nɔ.ɛl\\","\\u\\","\\o\\","[nɔ.ɛl]"],"origines":["latin"],"url":"https://fr.wiktionary.org/wiki/No%C3%ABl"}]},"noële":{"variantes":[{"libelle":"Marie-Noële","type":"compose","id":"marie-noële"},{"libelle":"Noële-Philomène","type":"compose"}],"entrees":[{"mot":"Noële","section":"Prénom","etymologie":null,"api":[],"origines":[],"url":"https://fr.wiktionary.org/wiki/No%C3%ABle"}]},"noëline":{"variantes":[{"libelle":"Noeline","type":"orthographique","id":"noeline"},{"libelle":"Noelline","type":"orthographique","id":"noelline"},{"libelle":"Noellyne","type":"orthographique","id":"noellyne"},{"libelle":"Noelyn","type":"orthographique","id":"noelyn"},{"libelle":"Noelyne","type":"orthographique","id":"noelyne"},{"libelle":"Noelynn","type":"orthographique","id":"noelynn"},{"libelle":"Noéline","type":"orthographique","id":"noéline"},{"libelle":"Noélline","type":"orthographique"},{"libelle":"Noéllyne","type":"orthographique"},{"libelle":"Noélyn","type":"orthographique"},{"libelle":"Noélyne","type":"orthographique","id":"noélyne"},{"libelle":"Noélynn","type":"orthographique","id":"noélynn"},{"libelle":"Noëlline","type":"orthographique","id":"noëlline"},{"libelle":"Noëllyne","type":"orthographique","id":"noëllyne"},{"libelle":"Noëlyn","type":"orthogr